#!/bin/sh

# this is a simple shell script to run configure, with all options
# required: change pathnames to point to your locations

# copy required files first
cp ../../generic/oratcl.c .
cp ../../doc/oratcl.man .
cp ../orainit.sed  .
cp ../install.sh .

./configure \
	--prefix=/home/tpoindex/src/tcl-beta				\
	--exec-prefix=/home/tpoindex/src/tcl-beta			\
	--with-tcl-directory=/home/tpoindex/src/tcl-beta/tcl7.4		\
	--with-tcl-library=/home/tpoindex/src/tcl-beta/tcl7.4		\
	--with-tk-directory=/home/tpoindex/src/tcl-beta/tk4.0		\
	--with-tk-library=/home/tpoindex/src/tcl-beta/tk4.0		\
	--with-tclx=yes							\
	--with-tclx-directory=/home/tpoindex/src/tcl-beta/tclX7.4a	\
	--with-tclx-library=/home/tpoindex/src/tcl-beta/tclX7.4a	\
	--with-oracle-directory=/home/tpoindex/oracle			\
	--with-oracle-version=7
