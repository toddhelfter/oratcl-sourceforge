from user_tab_columns t, user_trigger_cols c
where t.table_name = '...' and c.trigger_name = '...' and c.table_name = '...' and  t.column_name = c.column_name
order by t.column_name
}
  set {ODv_ArHelp(usrTriggers,utrDescription)} {Description of Trigger.

select description
from user_triggers
where trigger_name = '...' and table_name = '...' and table_owner = '...'
}
  set {ODv_ArHelp(usrTriggers,utrWhen)} {When-clause of Trigger.

select when_clause
from user_triggers
where trigger_name = '...' and table_name = '...' and table_owner = '...'
}
  set {ODv_ArHelp(usrTriggers,utrBody)} {Body of Trigger.

select trigger_body
from user_triggers
where trigger_name = '...' and table_name = '...' and table_owner = '...'
}
  set {ODv_ArHelp(usrUser,uusProcedures)} {All Procedures, Funtions and Packages  of User.

select distinct name, type
from user_source
order by name
}
  set {ODv_ArHelp(usrUser,uusProcSource)} {Source text of Procedure, Function or Package.

select text
from user_source
where name = '...'
order by line
}

#########################
# User-Roles/Privileges #
#########################


  set {ODv_ArHelp(usrUser,usrRoles)} {Roles granted to User.

select role
from session_roles
order by role
}
  set {ODv_ArHelp(usrRoles,usrTables)} {Tables with Privileges granted to Role.

select o.object_id, o.created, o.status, o.object_name
from sys.user_objects o, sys.role_tab_privs r
where o.object_type = 'TABLE' and r.role = '...' and o.object_name = r.table_name and r.owner = '...'
order by o.object_name
}
  set {ODv_ArHelp(usrRoles,uroPrivileges)} {Privileges of Role.

select privilege, admin_option
from role_sys_privs
where role = '...'
order by privilege
}
  set {ODv_ArHelp(usrUser,uusPrivileges)} {Privileges granted to User or his Roles.

select privilege
from session_privs
order by privilege
}

set {ODv_ArHelp(usrUser,uusDevices)} {Objects with Devices of User

select distinct e.extent_id, e.blocks, e.tablespace_name, u.file_id, d.device_id 
from user_extents e, user_free_space u, sys.device_dfile$ d 
where u.file_id = d.file_id and e.tablespace_name = u.tablespace_name and e.segment_name = '...' 
order by e.extent_id, u.file_id
}


####################
# User-Grants      #
####################


  set {ODv_ArHelp(usrUser,usrGrants)} {Grants to(by) User.

select grantee, owner, table_name, grantor, privilege,  grantable
from user_tab_privs
where grantee(grantor) = '...'
order by owner, table_name, grantee
}
  set {ODv_ArHelp(usrGrants,usrTables)} {Table with Grant on it.

select object_id, created, status, object_name
from user_objects
where object_type = 'TABLE'  and object_name = '...'
order by object_name
}
  set {ODv_ArHelp(usrGrants,usrColumns)} {Column with Grant on it.

select t.column_name, t.table_name, t.data_type, t.data_length, t.data_precision, t.data_scale, t.nullable, t.column_id, t.default_length, t.data_default, t.num_distinct, t.low_value, t.high_value
from user_tab_columns t, user_col_privs g
where t.table_name = '...' and g.owner = '...' and g.table_name = '...' and g.grantee = '...' and g.grantor = '...' and t.column_name = g.column_name
order by t.column_name
}
  set {ODv_ArHelp(usrGrants,usrViews)} {View with Grant on it.

select object_id, created, status, object_name
from user_objects
where object_type = 'VIEW'  and object_name = '...'
order by object_name
}


