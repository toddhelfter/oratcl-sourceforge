where owner = '...'
order by column_name
}
  set {ODv_ArHelp(sysColumns,sysTables)} {Table containing Column.

select o.object_id, o.created, o.status, o.object_name, o.owner
from sys.dba_objects o, sys.dba_tab_columns c
where o.owner = '...' and o.object_name = '...' and o.object_type = 'TABLE' and c.owner = '...' and c.table_name = '...' and c.column_name = '...' order by o.object_name
}
  set {ODv_ArHelp(sysColumns,sysViews)} {View containing Column.

select o.object_id, o.created, o.status, o.object_name, o.owner
from sys.dba_objects o, sys.dba_tab_columns c
where o.owner = '...' and o.object_name = '...' and o.object_type = 'VIEW' and c.owner = '...' and c.table_name = '...' and c.column_name = '...'
order by o.object_name
}
  set {ODv_ArHelp(sysColumns,sysIndexes)} {Indexes on Column.

select t.index_name, t.owner, t.table_owner, t.table_name, t.table_type, t.uniqueness, t.tablespace_name, t.ini_trans, t.max_trans, t.initial_extent, t.next_extent, t.min_extents, t.max_extents, t.pct_increase, t.pct_free, t.blevel, t.leaf_blocks, t.distinct_keys, t.avg_leaf_blocks_per_key, t.avg_data_blocks_per_key,  t.clustering_factor, t.status
from sys.dba_indexes t , sys.dba_ind_columns c
where t.owner = '...' and c.index_owner = '...' and t.table_name = '...' and c.table_name = '...' and c.column_name = '...' and t.index_name = c.index_name
