}
  set {ODv_ArHelp(sysConstraints,sysColumns)} {Columns in constraint definition.

select t.column_name, t.table_name, t.owner, t.data_type, t.data_length, t.data_precision, t.data_scale, t.nullable, t.column_id, t.default_length, t.data_default, t.num_distinct, t.low_value, t.high_value
from sys.dba_tab_columns t, sys.dba_cons_columns c
where c.constraint_name = '...' and t.owner = '...' and c.owner = '...' and c.table_name = t.table_name and t.column_name = c.column_name
order by t.column_name
}


