from sys.dba_triggers
where owner = '...'
order by trigger_name, table_owner, table_name
}
  set {ODv_ArHelp(sysTriggers,sysTables)} {Table related to Trigger.

select object_id, created, status, object_name, owner
from sys.dba_objects
where object_type = 'TABLE' and owner = '...' and object_name = '...'
order by object_name
}
  set {ODv_ArHelp(sysTriggers,sysColumns)} {Columns related to Trigger.

select t.column_name, t.table_name, t.owner, t.data_type, t.data_length, t.data_precision, t.data_scale, t.nullable, t.column_id, t.default_length, t.data_default, t.num_distinct, t.low_value, t.high_value
from sys.dba_tab_columns t, sys.dba_trigger_cols c
where t.owner = '...'  and t.table_name = '...' and c.trigger_owner = '...' and c.trigger_name = '...' and c.table_owner = '...' and c.table_name = '...' and  t.column_name = c.column_name
order by t.column_name
}
  set {ODv_ArHelp(sysTriggers,strDescription)} {Description of Trigger.

