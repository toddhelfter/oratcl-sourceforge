# Columns-Formats               #
#################################

# Format used for nullable,backed_up,grantable,admin_option,password_required,default_role,r_constraint_type
global {ODv_f_small}
  set {ODv_f_small} {%-5s}

# Format used for triggering_event,privilege
global {ODv_f_long} 
  set {ODv_f_long} {%-30s}

# Format used for referencing_names,dblink,host,fs_system
global {ODv_f_verylong}
  set {ODv_f_verylong} {%-50s}

# Format used for file_name,mount
global {ODv_f_longest}
  set {ODv_f_longest} {%-100s}
 
#Format used for data_length,data_precision,data_scale,default_length,low_value,high_value,initial_extent,next_extent,min_extent,max_extent,pct_increase,pct_free,pct_used,blevel,leaf_blocks,distinct_keys,bytes,blocks,num_rows,length,key_size,function,hashkeys,position,num_ext_free_ext,num_distinct,incr_by,cycle_flag,order_flag,cache_size,last_number,avg_key,extents,instance_num,device_id
global {ODv_f_nrsmall}
  set {ODv_f_nrsmall} {%9s}

# Format used for ini_trans,max_trans,clustering_factor,empty_blocks,avg_space,chain_cnt,max_bytes,max_blocks,head_file,head_block,free_list,free_group,used,free,percent
global {ODv_f_nr}
  set {ODv_f_nr} {%11s}

# Format used for avg_leaf_blocks_per_key,avg_data_blocks_per_key,avg_row_len
global {ODv_f_nrlong}
  set {ODv_f_nrlong} {%13s}

# Format used for min_value,max_value
global {ODv_f_nrverylong}
  set {ODv_f_nrverylong} {%30s}

# Format used for column_name,cluster_name,tablespace_name,constraint_name,referenced_names,role,sequence_name,grantee
global {ODv_f_object}
  set {ODv_f_object} {%-24s}

# Format used for synonym_name,index_name,trigger_name,table_name,view_name,segment_name
global {ODv_f_objectlong}
  set {ODv_f_objectlong} {%-27s}

# Format used for owner,user,grantor
global {ODv_f_user}
  set {ODv_f_user} {%-12s}

# Format used for id
global {ODv_f_id}
  set {ODv_f_id} {%7s}

# Format used for object_types,data_type,referenced_type
global {ODv_f_typesmall}
  set {ODv_f_typesmall} {%-12s}

# Format used for trigger_type,segment_type
global {ODv_f_typelong}
  set {ODv_f_typelong} {%-20s}

# Format used for status,profile,created,data_default,uniqueness
global {ODv_f_rest}
  set {ODv_f_rest} {%-10s}


