  set {ODv_ArHelp(sysSystem,sysTablespaces)} {All Tablespaces in database.

select tablespace_name, initial_extent, next_extent,  min_extents, max_extents, pct_increase, status
from sys.dba_tablespaces
order by tablespace_name
}
  set {ODv_ArHelp(sysTablespaces,sysTables)} {All Tables in Tablespace.

select o.object_id, o.created, o.status, o.object_name, o.owner
from sys.dba_objects o, sys.dba_tables t
where o.object_type = 'TABLE' and t.tablespace_name = '...' and o.object_name = t.table_name
order by o.object_name
}
  set {ODv_ArHelp(sysTablespaces,sysIndexes)} {All Indexes in Tablespace.

select index_name, owner, table_owner, table_name,  table_type, uniqueness, tablespace_name, ini_trans,  max_trans, initial_extent, next_extent, min_extents, max_extents, pct_increase, pct_free, blevel, leaf_blocks,  distinct_keys, avg_leaf_blocks_per_key, avg_data_blocks_per_key, clustering_factor, status
from sys.dba_indexes
where tablespace_name = '...'
order by index_name, table_owner, table_name
}
  set {ODv_ArHelp(sysTablespaces,sysClusters)} {All Clusters in Tablespace.

select o.object_id, o.created, o.status, o.object_name, o.owner
from sys.dba_objects o, sys.dba_clusters c
where o.object_type = 'CLUSTER' and o.owner = c.owner and o.object_name = c.cluster_name and c.tablespace_name = '...'
order by object_id
}
  set {ODv_ArHelp(sysTablespaces,sysExtents)} {All Extents in Tablespace.

select extent_id, segment_name, owner, segment_type, tablespace_name, file_id, block_id, bytes, blocks
from sys.dba_extents
where tablespace_name = '...'
order by segment_name, extent_id
}
  set {ODv_ArHelp(sysTablespaces,stsFiles)} {Information about Files of Tablespace.

select file_id, bytes, blocks, status, file_name
from sys.dba_data_files
where tablespace_name = '...'
order by file_name
}
  set {ODv_ArHelp(sysTablespaces,stsUserquotas)} {Quotas for all Users in Tablespace.

select username, bytes, max_bytes, blocks, max_blocks
from sys.dba_ts_quotas
where tablespace_name = '...'
order by username
}
  set {ODv_ArHelp(sysTablespaces,stsSegments)} {All Segments in Tablespace.

select owner, segment_name, segment_type, header_file, header_block, bytes, blocks, extents, initial_extent, next_extent, min_extents, max_extents, pct_increase, freelists, freelist_groups
from sys.dba_segments
where tablespace_name = '...'
order by owner, segment_name, segment_type
}
  set {ODv_ArHelp(sysTablespaces,sysUser)} {Users with Extents in Tablespace.

select distinct u.username, u.user_id, u.default_tablespace, u.temporary_tablespace, u.created, u.profile
from sys.dba_users u, sys.dba_extents e
where e.tablespace_name = '...' and e.owner = u.username
order by u.username

OR

Users with default(temporary) Tablespace.

select username, user_id, default_tablespace, temporary_tablespace, created, profile
from sys.dba_users 
where default(temporary)_tablespace = '...'
order by username
}


