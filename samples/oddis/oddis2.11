from all_col_privs_made
where owner = '...' and table_name = '...' and column_name = '...'
order by grantee
}
  set {ODv_ArHelp(allColumns,acoComments)} {Comments on Column.

select comments 
from all_col_comments 
where column_name = '...' and owner = '...' and table_name = '...' 
}


