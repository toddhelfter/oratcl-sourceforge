####################


  set {ODv_ArHelp(usrUser,usrTables)} {All Tables of User. 

select object_id, created, status, object_name
from user_objects
where object_type = 'TABLE'
order by object_name
}
  set {ODv_ArHelp(usrTables,usrColumns)} {Columns of Table.

select column_name, table_name, data_type, data_length,  data_precision, data_scale, nullable, column_id, default_length, data_default, num_distinct, low_value, high_value
from user_tab_columns
where table_name = '...'
order by column_name
}
  set {ODv_ArHelp(usrTables,usrIndexes)} {Indexes on Table.

select index_name, table_owner, table_name,  table_type, uniqueness, tablespace_name, ini_trans,  max_trans, initial_extent, next_extent, min_extents, max_extents, pct_increase, pct_free, blevel, leaf_blocks,  distinct_keys, avg_leaf_blocks_per_key, avg_data_blocks_per_key, clustering_factor, status
from user_indexes
where table_name = '...'
order by index_name, table_owner, table_name
}
  set {ODv_ArHelp(usrTables,usrViews)} {Dependent Views on Table.

select o.object_id, o.created, o.status, o.object_name
from user_dependencies d, user_objects o
where d.referenced_owner = '...' and d.referenced_name = '...'  and d.referenced_type = 'TABLE' and d.name = o.object_name and o.object_type = 'VIEW'
order by o.object_name
}
  set {ODv_ArHelp(usrTables,usrClusters)} {Cluster of Table.

select o.object_id, o.created, o.status, o.object_name
from user_objects o, user_tables t
where o.object_type = 'CLUSTER' and t.table_name = '...' and t.cluster_name = o.object_name
