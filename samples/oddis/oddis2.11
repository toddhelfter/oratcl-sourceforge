# System-Help                           #
#########################################


#########################
# System-User           #
#########################


  set {ODv_ArHelp(sysSystem,sysUser)} {All Users in database.

select username, user_id, default_tablespace, temporary_tablespace, created, profile
from sys.dba_users
order by username
}


##########################
# System-User-Tables     #
##########################

  set {ODv_ArHelp(sysUser,sysTables)} {All Tables of User.

select object_id, created, status, object_name, owner
from sys.dba_objects
where object_type = 'TABLE' and owner = '...'
order by object_name
}
  set {ODv_ArHelp(sysTables,sysColumns)} {Columns of Table.

select column_name, table_name, owner, data_type, data_length, data_precision, data_scale, nullable, column_id, default_length, data_default, num_distinct, low_value, high_value
from sys.dba_tab_columns
where owner = '...'  and table_name = '...'
order by column_name
}
  set {ODv_ArHelp(sysTables,sysIndexes)} {Indexes on Table.

select index_name, owner, table_owner, table_name, table_type, uniqueness, tablespace_name, ini_trans, max_trans,  initial_extent, next_extent,  min_extents, max_extents, pct_increase, pct_free, blevel, leaf_blocks,  distinct_keys,  avg_leaf_blocks_per_key, avg_data_blocks_per_key,  clustering_factor, status
from sys.dba_indexes
where owner = '...' and table_name = '...'
order by index_name, table_owner, tablespace_name
}
  set {ODv_ArHelp(sysTables,sysViews)} {Dependent Views on Table.

select o.object_id, o.created, o.status, o.object_name, o.owner
from sys.dba_dependencies d, sys.dba_objects o
where d.referenced_owner = '...' and d.referenced_name = '...'  and d.referenced_type = 'TABLE' and o.object_name = d.name and d.owner = o.owner and o.object_type = 'VIEW'
order by o.owner, o.object_id
}
  set {ODv_ArHelp(sysTables,sysClusters)} {Cluster of Table.

select o.object_id, o.created, o.status, o.object_name ,o.owner
from sys.dba_objects o, sys.dba_tables t
where o.object_type = 'CLUSTER' and t.owner = '...' and t.table_name = '...' and t.cluster_name = o.object_name
order by o.object_id
}
  set {ODv_ArHelp(sysTables,sysTablespaces)} {Tablespace of Table.

select s.tablespace_name, s.initial_extent, s.next_extent,  s.min_extents, s.max_extents, s.pct_increase, s.status
from sys.dba_tablespaces s, sys.dba_tables t
where t.owner = '...' and t.table_name = '...' and t.tablespace_name = s.tablespace_name
order by s.tablespace_name
}
  set {ODv_ArHelp(sysTables,sysExtents)} {Extents of Table.

select extent_id, segment_name, owner, segment_type, tablespace_name, file_id, block_id, bytes, blocks
from sys.dba_extents
where owner = '...' and segment_name = '...'
order by segment_name, extent_id
}
  set {ODv_ArHelp(sysTables,sysSynonyms)} {Synonyms for Table.

select synonym_name, owner, table_owner, table_name, db_link
from sys.dba_synonyms
where owner = '...' and table_name = '...'
order by synonym_name, table_owner
}
  set {ODv_ArHelp(sysTables,sysConstraints)} {Constraint definitions on Table.

select constraint_name, table_name, owner, constraint_type, r_owner, r_constraint_name
from sys.dba_constraints
where owner = '...' and table_name = '...'
order by constraint_name, r_owner, r_constraint_name
}
  set {ODv_ArHelp(sysTables,sysTriggers)} {Triggers on Table.

select distinct trigger_name, owner, table_owner, table_name, trigger_type, triggering_event, status, referencing_names
from sys.dba_triggers
where table_owner = '...' and table_name = '...'
order by trigger_name, table_owner, table_name
}
  set {ODv_ArHelp(sysTables,sysRoles)} {Roles with granted Privileges on Table.

select role, owner, table_name, privilege, grantable
from sys.role_tab_privs
where owner = '...' and table_name = '...'
order by role, privilege
}
  set {ODv_ArHelp(sysTables,sysGrants)} {Grants on Table.

select grantee, owner, table_name, grantor, privilege, grantable
from sys.dba_tab_privs  
where owner = '...' and table_name = '...'
order by grantor
}
  set {ODv_ArHelp(sysTables,staDetails)} {Details of Table.

select tablespace_name, pct_free, pct_used, ini_trans, max_trans, initial_extent, next_extent, min_extents, max_extents, pct_increase, backed_up, num_rows, blocks, empty_blocks, avg_space, chain_cnt, avg_row_len, cluster_name
from sys.dba_tables
where owner = '...' and table_name = '...'
order by tablespace_name
}
  set {ODv_ArHelp(sysTables,staComments)} {Comments on Table.

select comments 
from sys.dba_tab_comments 
where owner = '...' and table_name = '...' and table_type = 'TABLE' 
}
  set {ODv_ArHelp(sysTables,sysUser)} {Owner of Table.

select username, user_id, default_tablespace, temporary_tablespace, created, profile
from sys.dba_users
where username = '...'
order by username
}


