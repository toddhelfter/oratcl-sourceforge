####################
# ALL-Tables       #
####################


  set {ODv_ArHelp(allObjects,allTables)} {All Tables accessible to User.

select object_id, created, status, object_name, owner
from all_objects
where object_type = 'TABLE'
order by owner, object_name
}
  set {ODv_ArHelp(allTables,allColumns)} {Columns of Table.

select column_name, table_name, owner, data_type, data_length,  data_precision, data_scale, nullable, column_id, default_length, data_default, num_distinct, low_value, high_value
from all_tab_columns
where table_name = '...' and owner = '...'
order by column_id
}
  set {ODv_ArHelp(allTables,allIndexes)} {Indexes on Table.

select index_name, owner, table_owner, table_name, table_type, uniqueness, tablespace_name, ini_trans, max_trans,  initial_extent, next_extent,  min_extents, max_extents, pct_increase, pct_free, blevel, leaf_blocks,  distinct_keys,  avg_leaf_blocks_per_key, avg_data_blocks_per_key,  clustering_factor, status
from all_indexes
where owner = '...' and table_name = '...'
order by index_name, table_owner, tablespace_name
}
  set {ODv_ArHelp(allTables,allViews)} {Dependent Views on Table.

select o.object_id, o.created, o.status, o.Object_name, o.owner
from sys.all_dependencies d, sys.all_objects o
where d.referenced_owner = '...' and d.referenced_name = '...'  and d.referenced_type = 'TABLE' and d.owner = o.owner and d.name = o.object_name and o.object_type = 'VIEW'
order by o.owner, o.object_name
}
  set {ODv_ArHelp(allTables,allTablespaces)} {Tablespace of Table.

select s.tablespace_name, s.initial_extent, s.next_extent,  s.min_extents, s.max_extents, s.pct_increase, s.status
from user_tablespaces s, all_tables t
where t.owner = '...' and t.table_name = '...' and t.tablespace_name = s.tablespace_name
order by s.tablespace_name
}
  set {ODv_ArHelp(allTables,allSynonyms)} {Synonyms for Table.

select synonym_name, owner, table_owner, table_name, db_link
from all_synonyms
where table_owner = '...' and table_name = '...'
order by synonym_name, owner
}
  set {ODv_ArHelp(allTables,allConstraints)} {Constraint definitions on Table.

select constraint_name, table_name, owner,constraint_type, r_owner, r_constraint_name
from all_constraints
where owner = '...' and table_name = '...'
order by constraint_name, r_owner, r_constraint_name
}
  set {ODv_ArHelp(allTables,allTriggers)} {Triggers related to Table.

select distinct trigger_name, owner, table_owner, table_name, trigger_type, triggering_event, status, referencing_names
from all_triggers
where table_owner = '...' and table_name = '...'
order by trigger_name, table_owner, table_name
}
  set {ODv_ArHelp(allTables,allGrants)} {Grants to User on Table.

select grantee, owner, table_name, grantor, privilege, grantable
from all_tab_privs_recd
where owner = '...' and table_name = '...'
order by grantee,grantor 

OR

Grants by User on Table.

select grantee, owner, table_name, grantor, privilege, grantable
from all_tab_privs_made
where owner = '...' and table_name = '...'
order by grantee,grantor 
}
  set {ODv_ArHelp(allTables,ataDetails)} {Details of Table.

select tablespace_name, pct_free, pct_used, ini_trans, max_trans, initial_extent, next_extent, min_extents, max_extents, pct_increase, backed_up, num_rows, blocks, empty_blocks, avg_space, chain_cnt, avg_row_len,cluster_name
from all_tables
where owner = '...' and table_name = '...'
order by tablespace_name
}
  set {ODv_ArHelp(allTables,ataComments)} {Comments on Table.

select comments 
from all_tab_comments 
where owner = '...' and table_name = '...' and table_type = 'TABLE' 
}


#####################
# ALL-Columns       #
#####################


  set {ODv_ArHelp(allObjects,allColumns)} {All Columns accessible to User.

select column_name, table_name, owner, data_type, data_length,  data_precision, data_scale, nullable, column_id, default_length, data_default, num_distinct, low_value, high_value
from all_tab_columns
order by owner, table_name, column_name
}
  set {ODv_ArHelp(allColumns,allTables)} {Table containing Column.

select o.object_id, o.created, o.status, o.object_name, o.owner
from all_tab_columns c, all_objects o
where c.owner = '...' and c.table_name = '...' and c.column_name = '...' and o.object_name = '...' and o.owner = '...' and o.object_type = 'TABLE'
order by c.table_name
}
  set {ODv_ArHelp(allColumns,allIndexes)} {Indexes on Column.

select i.index_name, i.owner, i.table_owner, i.table_name, i.table_type, i.uniqueness, i.tablespace_name, i.ini_trans, i.max_trans, i.initial_extent, i.next_extent, i.min_extents, i.max_extents, i.pct_increase, i.pct_free, i.blevel, i.leaf_blocks, i.distinct_keys, i.avg_leaf_blocks_per_key, i.avg_data_blocks_per_key, i.clustering_factor, i.status
from all_indexes i, all_ind_columns c
where i.owner = '...' and c.index_owner = '...' and i.table_name = '...' and c.table_name = '...' and c.column_name = '...' and i.index_name = c.index_name
order by i.index_name, i.table_owner, i.tablespace_name
}
  set {ODv_ArHelp(allColumns,allViews)} {View containing Column.

select o.object_id, o.created, o.status, o.object_name, o.owner
from all_objects o, all_tab_columns c
where  c.owner = '...' and c.table_name = '...' and c.column_name = '...' and o.object_name = '...' and o.owner = '...' and o.object_type = 'VIEW' 
order by o.object_name
}
  set {ODv_ArHelp(allColumns,allConstraints)} {Constraint definitions on Column.

select t.constraint_name, t.table_name, t.owner, t.constraint_type, t.r_owner, t.r_constraint_name
from all_constraints t, all_cons_columns c
where t.table_name = '...' and c.table_name = '...' and c.column_name = '...'
order by t.constraint_name, t.r_owner, t.r_constraint_name
}
  set {ODv_ArHelp(allConstraints,allColumns)} {Columns in Constraint definition.

select t.column_name, t.table_name, t.owner, t.data_type, t.data_length, t.data_precision, t.data_scale, t.nullable, t.column_id, t.default_length, t.data_default, t.num_distinct, t.low_value, t.high_value
from all_tab_columns t, all_cons_columns c
where t.table_name = '...' and c.table_name = '...' and t.owner = '...' and c.owner = '...' and c.constraint_name = '...' and c.column_name = t.column_name
order by t.column_name
}
  set {ODv_ArHelp(allColumns,allTriggers)} {Triggers on Column.

select distinct t.trigger_name, t.owner, t.table_owner, t.table_name, t.trigger_type, t.triggering_event, t.status, t.referencing_names
from all_triggers t, all_trigger_cols c
where t.table_owner = '...' and c.table_owner = '...' and t.table_name = '...' and c.table_name = '...' and t.trigger_name = c.trigger_name and t.owner = c.trigger_owner and c.column_name = '...'
order by t.trigger_name, t.table_owner, t.table_name
}
  set {ODv_ArHelp(allColumns,allGrants)} {Grants to User on Column.

select grantee, owner, table_name, grantor, privilege, grantable
from all_col_privs_recd
where owner = '...' and table_name = '...' and column_name = '...'
order by grantee

OR

Grants by User on Column.

