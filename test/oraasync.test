#
# exercise various oraasync operations
#

set oratcl___async1 { \
	create or replace function oratcl___async1 ( \
		 arg_int number \
	) return number as begin \
		var_int number; \
	begin \
		select 22+arg_int into var_int from dual; \
	end;}

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

global ora_constr
set async_lda [oralogon $ora_constr -async]
set block_lda [oralogon $ora_constr]
set async_stm [oraopen $async_lda]
set block_stm [oraopen $async_lda]

#oraplexec $block_stm $oratcl___async1
orasql $block_stm $oratcl___async1

#
# ::oratcl__async_parse section
#
test oratcl::async_parse-1.1 {::oratcl::async_parse command} {
	info commands ::oratcl::async_parse
} {::oratcl::async_parse}

test oratcl::async_parse-1.2 {::oratcl::async_parse command (SQL)} {
	set sql {select * from oratcl___tests where v_number < 0}	
	::oratcl::async_parse $async_stm $sql
	while {[oramsg $async_stm rc] == $::oratcl::codes(OCI_STILL_EXECUTING)} {
		::oratcl::async_parse $async_stm $sql
	}
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_parse-1.3 {oraasync parse command (SQL)} {
	set sql {select * from oratcl___tests where v_number < 0}	
	oraasync parse $async_stm $sql
	while {[oramsg $async_stm rc] == $::oratcl::codes(OCI_STILL_EXECUTING)} {
		oraasync parse $async_stm $sql
	}
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_parse-1.4 {::oratcl::async_parse command (PL/SQL)} {
	set pl {declare my_result number; begin :my_result := oratcl___async1(:in1); end;}

	::oratcl::async_parse $async_stm $pl
	while {[oramsg $async_stm rc] == $::oratcl::codes(OCI_STILL_EXECUTING)} {
		::oratcl::async_parse $async_stm $pl
	}
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_parse-1.5 {oraasync parse command (PL/SQL)} {
	set pl {declare my_result number; begin :my_result := oratcl___async1(:in1); end;}

	oraasync parse $async_stm $pl
	while {[oramsg $async_stm rc] == $::oratcl::codes(OCI_STILL_EXECUTING)} {
		oraasync parse $async_stm $pl
	}
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

#
# ::oratcl__async_bind section
#
test oratcl::async_bind-2.1 {::oratcl::async_bind command} {
	info commands ::oratcl::async_bind
} {::oratcl::async_bind}

test oratcl::async_bind-2.2 {::oratcl::async_bind command (SQL)} {
	set sql {select * from oratcl___tests where v_number < :zero}	
	::oratcl::async_parse $async_stm $sql
	while {[oramsg $async_stm rc] == $::oratcl::codes(OCI_STILL_EXECUTING)} {
		::oratcl::async_parse $async_stm $sql
	}
	::oratcl::async_bind $async_stm :zero 0
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_bind-2.3 {oraasync bind command (SQL)} {
	set sql {select * from oratcl___tests where v_number < :zero}	
	oraasync parse $async_stm $sql
	while {[oramsg $async_stm rc] == $::oratcl::codes(OCI_STILL_EXECUTING)} {
		oraasync parse $async_stm $sql
	}
	oraasync bind $async_stm :zero 0
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_exec-3.1 {::oratcl::async_exec command} {
	info commands ::oratcl::async_exec
} {::oratcl::async_exec}

test oratcl::async_fetch-4.1 {::oratcl::async_fetch command} {
	info commands ::oratcl::async_fetch
} {::oratcl::async_fetch}

orasql $block_stm "drop function oratcl___async1"

oraclose $async_stm
oralogoff $async_lda

::tcltest::cleanupTests
return
