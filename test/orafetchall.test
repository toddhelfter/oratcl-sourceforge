# more exhaustive test than what is in basic_tests.test
# tests internal function orafetch-all
package require Oratcl

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*
}



test orafetchtest {test oratcl cmd orafetch} {
    set handle [oralogon scott/tiger@or8i]
    set cursor [oraopen $handle]
    orasql $cursor "select ename from emp order by ename"
    set num_rows 0
    orafetch $cursor {
      incr num_rows
      if {[string compare @1 M] == 1} {
         # employee name greater than "L", break out of orafetch
         break
      }
      if {$num_rows > 5} {
         # more than five rows in query, don't print anymore
         continue
      }
     
      set name @0
  }
  oralogoff $handle
  set result $name   
  } {FORD}

::tcltest::cleanupTests
return 
