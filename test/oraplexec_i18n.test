#
# This file contains a collection of tests for one or more of the Tcl
# built-in commands.  Sourcing this file into Tcl runs the tests and
# generates output for errors.  No output means no errors were found.
#
# This test first creates a temporary table in the database that contains 
# unicode data in the columns. Then the  Oratcl command oraplexec is
# called using a unicode value with a bind variable.
# 
# Copyright (c) 1998-1999 by Scriptics Corporation.
# All rights reserved.
#
# RCS: @(#) $Id: oraplexec_i18n.test,v 1.1 1999-08-09 18:26:56 mtariq Exp $


set pl_proc {
  create procedure total_salary
    (job_type in varchar2,
     tot_sal out number)
  as 
    tot_fixed NUMBER;
       
   begin
    select sum(sal) into tot_fixed
     from test_int
     where job = job_type;
   tot_sal := tot_fixed;
   end;
}

set anon_plblck {
   begin
    total_salary (:type, :total);
   end;
}

test oraplex-int {test of i18n on oraplexec} {
    oralogon system/manager
    oraopen oratcl0.0
    set x \u00c3\u00a9
    orasql oratcl0.0 "create table test_int (name varchar(20), sal int, job varchar(15))"
    orasql oratcl0.0 "insert into test_int (name, sal, job) values ('Joe', 100,'$x')"
    orasql oratcl0.0 "insert into test_int (name, sal, job) values ('Joe', 200,
    '$x')"
    orasql oratcl0.0 "insert into test_int (name, sal, job) values ('Joe', 300,
    '$x')"
    oraplexec oratcl0.0 $pl_proc
    oraplexec oratcl0.0 $anon_plblk :type $x :total 0
} "$x 600"

::tcltest::cleanupTests

return



