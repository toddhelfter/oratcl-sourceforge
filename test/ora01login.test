#
# exercise oralogon and oralogoff
#

if {[info exists ora_lda] == 0} {
        source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

test oralogon-1.0 {oralogon: no arguments} {
  catch {oralogon} res
  set res
} {wrong # args: should be "oralogon connect_str"}

test oralogon-1.1 {oralogon: all arguments} {
  global ora_constr
  catch {oralogon $ora_constr} res
  catch {oralogoff $lda}
  set res
} {oratcl1}

test oralogon-1.2 {oraopen: max connections} {
	global ora_lda ora_constr
 
	set llda(0) {}
	set ores(0) {}
	set cres(0) {}
 
	set ix 2
	set res 1
	while {$res} {
		set llda($ix) {}
		catch {set llda($ix) [oralogon $ora_constr]} ores($ix)
		if { [string range $llda($ix) 0 5] != {oratcl}} {
			set res 0
		} else {
			incr ix
		}
	}
 
	for {set jx 2} {$jx < $ix} {incr jx} {
		catch {oralogoff $llda($jx)} cres($jx)
	}
	set ores($ix)
} {oralogon: no lda handles available}

::tcltest::cleanupTests
return
