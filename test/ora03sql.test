#
# exercise various combinations of orasql and orafetch
#

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

test orasql-1.1 {orasql: no rows returned} {
  global oramsg
  orasql $ora_cur {select * from oratcl___tests where v_number < 0}
  set oramsg(rows)
} {0}

test orasql-1.2 {orasql: no more results} {
  global oramsg
  orasql $ora_cur {select * from oratcl___tests where v_number < 0}
  orafetch $ora_cur
  set oramsg(rc)
} {1403}

test orasql-1.3 {orasql: one row returned} {
  global oramsg
  orasql $ora_cur {select * from oratcl___tests where v_number = 0}
  set cnt 0
  orafetch $ora_cur {incr cnt}
  set cnt
} {1}

test orasql-1.4 {orasql: 30 rows returned} {
  orasql $ora_cur {select * from oratcl___tests}
  set cnt 0
  orafetch $ora_cur {incr cnt}
  set cnt
} {30}

test orasql-1.5 {orasql: multiple result sets} {
  orasql $ora_cur {select * from oratcl___tests}
  orasql $ora_cur2 {select * from oratcl___tests}
  set cnt1 0
  set cnt2 0
  orafetch $ora_cur {incr cnt1}
  orafetch $ora_cur2 {incr cnt2}
  format "$cnt1 $cnt2"
} {30 30}

test orasql-1.6 {orasql: multiple result sets with one compute row (buffered row)} {
  orasql $ora_cur {select count(v_number), sum(v_number) from oratcl___tests}
  set cnt1 0
  set cnt2 0
  orafetch $ora_cur {set cnt1 @1; set cnt2 @2}
  format "$cnt1 $cnt2 $oramsg(rc)"
} {30 435 1403}

test orasql-1.8 {orasql: orafetch commands with break} {
  orasql $ora_cur {select * from oratcl___tests}
  set cnt1 0
  set i 0
  orafetch $ora_cur {incr cnt1; incr i; if {$i>22} {break}}
  orafetch $ora_cur {incr cnt1}
  format "$cnt1 $oramsg(rc)"
} {30 1403}

test orasql-1.9 {orasql: orafetch correct number of rows and columns} {
  set numCols 4
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set exp1 0
  set exp2 0
  set exp3 0
  set row [orafetch $ora_cur]
  set exp1 [expr {$numCols == [llength $row]}]
  set row [orafetch $ora_cur]
  set exp2 [expr {$numCols == [llength $row]}]
  set row [orafetch $ora_cur]
  set exp3 [expr {$numCols == [llength $row]}]
  format "$exp1 $exp2 $exp3"
} {1 1 0}

test orasql-1.10 {orasql: orafetch with command number substitution columns} {
  set numCols 4
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set cnt1 0
  set cnt2 0
  orafetch $ora_cur {set cnt1 [llength @0]}
  set cnt2 [expr {$numCols == $cnt1}]
  set cnt2
} {1}

test orasql-1.11 {orasql: orafetch with commands number substitution columns} {
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [llength [list @1 @2 @3] ]}
  set cnt1
} {3}

test orasql-1.12 {orasql: orafetch with commands alternate substitution character} {
  set numCols 4
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set cnt1 0
  set cnt2 0
  orafetch $ora_cur {set cnt1 [llength %0]} {%}
  set cnt2 [expr {$numCols == $cnt1}]
  set cnt2
} {1}

test orasql-1.13 {orasql: orafetch with commands alternate substitution character} {
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [llength [list %1 %2 %3] ]} {%}
  set cnt1
} {3}

test orasql-1.14 {orasql: orafetch with commands no sub char } {
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [llength @0]} { }
  set cnt1
} {1}

test orasql-1.15 {orasql: orafetch with commands tclvars as additional parms } {
  set numCols 4
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [llength $row]} {} row 0
  set cnt2 [expr {$numCols == $cnt1}]
  set cnt2
} {1}

test orasql-1.16 {orasql: orafetch with commands tclvars as additional parms } {
  set numCols 4
  orasql $ora_cur {select * from oratcl___tests where v_number < 3}
  set cnt1 0
  set cnt2 0
  set cnt3 0
  orafetch $ora_cur {
    incr cnt1 $col1; set cnt2 $col1; set cnt3 $col1} {} col3 3 col2 2 col1 1
  format "$cnt1 $cnt2 $cnt3"
} {3 2 2}

test orasql-1.17 {orasql: orafetch with commands tclvars as list} {
  set numCols 4
  orasql $ora_cur {select * from oratcl___tests where v_number < 2}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [llength $row]} {} {row 0}
  set cnt2 [expr {$numCols == $cnt1}]
  set cnt2
} {1}

test orasql-1.18 {orasql: orafetch with commands tclvars} {
  set numCols 4

  set cnt1 0
  set cnt2 0
  set cnt3 0

  orasql $ora_cur {select * from oratcl___tests where v_number < 3}
  orafetch $ora_cur {incr cnt1 $col1; set cnt2 $col1; \
		set cnt3 $col1} {} col3 3 col2 2 col1 1
  format "$cnt1 $cnt2 $cnt3"
} {3 2 2}

test orasql-1.18.1 {orasql: orafetch with commands tclvars as list} {
  set numCols 4

  set cnt1 0
  set cnt2 0
  set cnt3 0

  orasql $ora_cur {select * from oratcl___tests where v_number < 3}
  orafetch $ora_cur {incr cnt1 $col1; set cnt2 $col1; \
		set cnt3 $col1} {} {col3 3 col2 2 col1 1}
  format "$cnt1 $cnt2 $cnt3"
} {3 2 2}

test orasql-1.19 {orasql: orafetch with commands substituion and tclvars} { set numCols 4
  orasql $ora_cur {select * from oratcl___tests where v_number < 3}
  set cnt1 0
  set cnt2 0
  set cnt3 0
  orafetch $ora_cur {
    set cnt1 [llength @0]; set cnt3 $col1} {@} {col3 3 col2 2 col1 1}
  set cnt2 [expr {$numCols == $cnt1}]
  format "$cnt2 $cnt3"
} {1 2}

test orasql-1.19 {orasql: no results returned, sql update} {
  orasql $ora_cur "update oratcl___tests set v_number=0 where v_number <0"
  set oramsg(rc)
} {0}

test orasql-1.20 {orasql: no results returned, sql create index} {
  orasql $ora_cur {create index oratcl___tests_idx1 on oratcl___tests(v_number)}
  set oramsg(rc)
} {0}

test orasql-1.21 {orasql: no results returned, sql drop index} {
  orasql $ora_cur {drop index oratcl___tests_idx1}
  set oramsg(rc)
} {0}

test orasql-1.22 {orasql: orafetch with commands quoted substitution character} {
  orasql $ora_cur {select v_number from oratcl___tests where v_number < 3}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [string length @@]}
  set cnt1
} {1}

test orasql-1.23 {orasql: orafetch with commands quoted substitution character} {
  orasql $ora_cur {select v_number from oratcl___tests where v_number < 3}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [string length %%]} {%}
  set cnt1
} {1}

test orasql-1.24 {orasql: orafetch with commands quoted substitution character} {
  orasql $ora_cur {select v_number from oratcl___tests where v_number < 3}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [string length @@]} {%}
  set cnt1
} {2}

test orasql-1.25 {orasql: orafetch with commands non-numeric substitution character} {
  orasql $ora_cur {select v_number from oratcl___tests where v_number < 3}
  set cnt1 0
  orafetch $ora_cur {set cnt1 [string length %b]} {%}
  set cnt1
} {2}

test orasql-1.26 {orasql: orafetch with commands invalid tclvar pairs} {
  orasql $ora_cur {select * from oratcl___tests where v_number < 3}
  set cnt1 0
  catch {orafetch $ora_cur {set cnt1 $col1} {} col1 1 col2} res
  set res
} {orafetch: column sanity failed on tclvar bind}

test orasql-1.27 {orasql: orafetch with commands invalid tclvar pair list} {
  orasql $ora_cur {select * from oratcl___tests where v_number < 3}
  set cnt1 0
  catch {orafetch $ora_cur {} {} {col1 1 col2} } res
  set res
} {orafetch: column sanity failed on tclvar bind}

test orasql-1.28 {orasql: orafetch with commands invalid column substitution} {
  orasql $ora_cur {select v_number from oratcl___tests where v_number < 3}
  set cnt1 0
  catch {orafetch $ora_cur {set cnt1 @2}} res
  set res
} {orafetch: column sanity failed on column sub}

test orasql-1.28.1 {orasql: orafetch with commands invalid column substitution} {
  orasql $ora_cur {select v_number from oratcl___tests where v_number < 3}
  set cnt1 0
  catch {orafetch $ora_cur {} {} cnt1 2} res
  set res
} {orafetch: invalid integer column}


test orasql-1.29 {orasql: orafetch with commands invalid tclvar substitution} {
  orasql $ora_cur {select v_number from oratcl___tests where v_number < 3}
  set cnt1 0
  catch {orafetch $ora_cur {set cnt1 $col2]} {} col2 2 }  res
  set res
} {orafetch: invalid integer column}

::tcltest::cleanupTests
return
