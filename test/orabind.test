# orabind.test
#
# Copyright (c) 2001 by Todd M. Helfter
# All rights reserved.
#
# exercise various combinations of orabind
#

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

test orabind-1.1 {orabind OCI_STMT_SELECT code == 1} {
	set sql {select * from oratcl___tests where v_number = :num}
	oraparse $ora_cur $sql
	orabind $ora_cur :num 0
	oramsg $ora_cur rc
} {0}

test orabind-1.2 {orabind OCI_STMT_UPDATE code == 2} {
	set sql {update oratcl___tests set v_number = :sn where v_number = :wn}
	oraparse $ora_cur $sql
	orabind $ora_cur :sn 0 :wn 0
	oramsg $ora_cur rc
} {0}

test orabind-1.3 {orabind OCI_STMT_DELETE code == 3} {
	set sql {delete from oratcl___tests where v_number = :wn}
	oraparse $ora_cur $sql
	orabind $ora_cur :wn 0
	oramsg $ora_cur rc
} {0}

test orabind-1.4 {orabind OCI_STMT_INSERT code == 4} {
	set sql {insert into oratcl___tests (v_number) values (:vn)}
	oraparse $ora_cur $sql
	orabind $ora_cur :vn 20
	oramsg $ora_cur rc
} {0}

test orabind-1.7 {orabind OCI_STMT_ALTER code == 7} {
	# ORA-01036: illegal variable name/number
	set sql {alter session set nls_date_format = :dateformat}
	oraparse $ora_cur $sql
	catch {orabind $ora_cur :dateformat DD-MON-YYYY}
	oramsg $ora_cur rc
} {1036}

test orabind-1.8 {orabind OCI_STMT_BEGIN code == 8} {
	set sql {begin bogus_package(:parm); end;}
	oraparse $ora_cur $sql
	orabind $ora_cur :parm 30
	oramsg $ora_cur rc
} {0}

test orabind-1.9 {orabind OCI_STMT_DECLARE code == 9} {
	set sql {declare x number(3); begin bogus_package(:parm); end;}
	oraparse $ora_cur $sql
	orabind $ora_cur :parm 30
	oramsg $ora_cur rc
} {0}

test orabind-2.1 {orabind too many binds} {
	# ORA-01036: illegal variable name/number
	set sql {select * from oratcl___tests where v_number = :wn}
	oraparse $ora_cur $sql
	catch {orabind $ora_cur :wn 0 :str {}}
	oramsg $ora_cur rc
} {1036}

test orabind-2.2 {orabind unbalanced binds} {
	# this currently does not return an error, only pairs get bound
	set sql {select * from oratcl___tests where v_number = :wn}
	oraparse $ora_cur $sql
	catch {orabind $ora_cur :wn}
	oramsg $ora_cur rc
} {0}

test orabind-2.3 {orabind bad name binds} {
	set sql {select * from oratcl___tests where v_number = :wn}
	oraparse $ora_cur $sql
	catch {orabind $ora_cur num 0} res
	set res
} {orabind: bind variable 'num' does not begin with ':'}

::tcltest::cleanupTests
return
