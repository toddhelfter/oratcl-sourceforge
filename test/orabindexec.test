#
# exercise various orabindexec
#

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

test orabindexec-1.1 {orabindexec: one bind value} {
	set tst_lda [oralogon $ora_constr]
	set tst_cur [oraopen $tst_lda]
	set sql1 {select v_number from oratcl___tests where v_char = :n1}
	orasql $tst_cur $sql1 -parseonly
	orabindexec $tst_cur :n1 {10}
	set rv1 [orafetch $tst_cur]
	oraclose $tst_cur
	oralogoff $tst_lda
	unset tst_cur
	unset tst_lda
	unset sql1
	set res $rv1
	unset rv1
	set res
} {10}

test orabindexec-1.2 {orabindexec: many bind values} {
  set sql2 {select v_number from oratcl___tests \
	where v_char = :n1 and v_number = :n2 and v_varchar2 like :n3}
  orasql $ora_cur3 $sql2 -parseonly
  orabindexec $ora_cur3 :n1 {10} :n2 {10} :n3 {10%}
  set rv1 [orafetch $ora_cur3]
  set res $rv1
  unset rv1
  set res
} {10}

test orabindexec-1.4 {orabindexec: too few bind values :: result} {
  set sql4 {select v_number from oratcl___tests \
	where v_char = :n1 and v_number = :n2 and v_varchar2 like :n3}
  orasql $ora_cur3 $sql4 -parseonly
  catch {orabindexec $ora_cur3 :n1 {10} :n2 {10}} res
  set res
} {orabindexec: SQL execution failed.}

test orabindexec-1.5 {orabindexec: too few bind values :: error code} {
  set sql4 {select v_number from oratcl___tests \
	where v_char = :n1 and v_number = :n2 and v_varchar2 like :n3}
  orasql $ora_cur3 $sql4 -parseonly
  catch {orabindexec $ora_cur3 :n1 {10} :n2 {10}} res
  set oramsg(rc)
} {1008}

test orabindexec-1.6 {orabindexec: no prior parse :: error code} {
	set tst_lda [oralogon $ora_constr]
	set tst_cur [oraopen $tst_lda]
	catch {orabindexec $tst_cur :n1 {10} :n2 {10}}
	set res $oramsg(rc)
	oraclose $tst_cur
	oralogoff $tst_lda
	unset tst_cur
	unset tst_lda
	set res
} {1036}

::tcltest::cleanupTests
return
