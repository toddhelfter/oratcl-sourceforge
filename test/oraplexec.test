# exercise various oraplexec operations
#

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl] }

set oratcl___test1 {
	create or replace function oratcl___test1 (
		arg_x number,
		arg_y char
	) return date as
	nres number(10);
	dres date;
	cursor cur_tests(arg_x number, arg_y char)
		is select v_number, v_date from oratcl___tests
			where v_number = arg_x
			and v_char = arg_y;
	begin

		open cur_tests(arg_x, arg_y);
		fetch cur_tests into nres, dres;
		close cur_tests;
		return dres;
	end;
}

set oratcl___test2 {
	create or replace function oratcl___test2 (
		arg_x number
	) return boolean as
	begin
		if (arg_x = 5) then
			return TRUE;
		else
			return FALSE;
		end if;
	end;
}

test oraplexec-1.0 {oraplexec: :bind = function(val, val)} {
  oraplexec $ora_cur $oratcl___test1
  oraplexec $ora_cur $oratcl___test2
} {}

test oraplexec-1.1 {oraplexec: :bind = function(val, val)} {
  set pl(1) {declare my_result date; begin :my_result := oratcl___test1(22, '22'); end;}
  oraplexec $ora_cur $pl(1) :my_result {}
  set rv(1) [orafetch $ora_cur]
  set res $rv(1)
  unset rv(1)
  set res
} [string toupper [clock format [clock seconds] -format {%d-%b-%Y}]]

test oraplexec-1.2 {oraplexec: :bind = function(:bindval, val)} {
  set pl(2) {declare my_result date; begin :my_result := oratcl___test1(:in1, '22'); end;}
  oraplexec $ora_cur $pl(2) :my_result {} :in1 22
  set rv(2) [orafetch $ora_cur]
  set res $rv(2)
  unset rv(2)
  set res
} [list [string toupper [clock format [clock seconds] -format {%d-%b-%Y}]] 22]

test oraplexec-1.3 {oraplexec: :bind = function(:bindval, :bindval)} {
  set pl(3) {declare my_result date; begin :my_result := oratcl___test1(:in1, :in2); end;}
  oraplexec $ora_cur $pl(3) :my_result {} :in1 22 :in2 {22}
  set rv(3) [orafetch $ora_cur]
  set res $rv(3)
  unset rv(3)
  set res 
} [list [string toupper [clock format [clock seconds] -format {%d-%b-%Y}]] 22 22]

test oraplexec-1.4 {oraplexec: bad bind pairs :: result} {
  set pl(4) {declare my_result date; begin :my_result := oratcl___test1(:in1, :in2); end;}
  catch {oraplexec $ora_cur $pl(4) :my_result {} :in1 22 :in2} res
  set res
} "ORA-01008: not all variables bound\n"

test oraplexec-1.5 {oraplexec: bad bind pairs :: error code} {
  set pl(5) {declare my_result date; begin :my_result := oratcl___test1(:in1, :in2); end;}
  catch {oraplexec $ora_cur $pl(5) :my_result {} :in1 22 :in2} res
  set oramsg(rc)
} {1008}

test oraplexec-1.6 {oraplexec: bad pl/sql :: error text} {
  set pl(9) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $ora_cur $pl(5) :my_result {} :in1 22 :in2} res
  set oramsg(errortxt)
} "ORA-01008: not all variables bound\n"

test oraplexec-1.7 {oraplexec: bad pl/sql :: result} {
  set pl(7) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $ora_cur $pl(7) :my_result {} :in1 22 :in2 22} res
  set res
} "ORA-06550: line 1, column 45:\nPLS-00201: identifier 'ORATCL___TEST' must be declared\nORA-06550: line 1, column 31:\nPL/SQL: Statement ignored\n"

test oraplexec-1.8 {oraplexec: bad pl/sql :: error code} {
  set pl(8) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $ora_cur $pl(8) :my_result {} :in1 22 :in2 22}
  set oramsg(rc)
} {6550}

test oraplexec-1.9 {oraplexec: bad pl/sql :: error text} {
  set pl(9) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $ora_cur $pl(9) :my_result {} :in1 22 :in2 22}
  set oramsg(errortxt)
} "ORA-06550: line 1, column 45:\nPLS-00201: identifier 'ORATCL___TEST' must be declared\nORA-06550: line 1, column 31:\nPL/SQL: Statement ignored\n"

test oraplexec-1.10 {oraplexec: :bind = function(val)} {
  set pls {declare my_result boolean; begin :my_result := oratcl___test2(5); end;}
  catch {oraplexec $ora_cur $pls :my_result {} } res
	#puts [array get oramsg]
  set res
} "ORA-06550: line 1, column 48:\nPLS-00382: expression is of wrong type\nORA-06550: line 1, column 34:\nPL/SQL: Statement ignored\n"

orasql $ora_cur "drop function oratcl___test1"
orasql $ora_cur "drop function oratcl___test2"

::tcltest::cleanupTests
return
