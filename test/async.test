#
# ::oratcl::async_fetch section
#
test oratcl::async_fetch-4.1 {::oratcl::orafetch command} {
	info commands ::oratcl::orafetch
} {::oratcl::orafetch}

test oratcl::async_fetch-4.2 {::oratcl::async_fetch command (SQL)} {
	set sql {select * from oratcl___tests where v_number < :three}	
	looping_async_parse_namespace $async_stm $sql
	::oratcl::orabind $async_stm :three 3
	looping_async_exec_namespace $async_stm
	set outvar [looping_async_fetch_namespace $async_stm]
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_fetch-4.3 {oraasync fetch command (SQL)} {
	set sql {select * from oratcl___tests where v_number < :three}	
	looping_async_parse $async_stm $sql
	orabind $async_stm :three 3
	looping_async_exec $async_stm
	set outvar [looping_async_fetch $async_stm]
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_fetch-4.4 {::oratcl::async_fetch command (PL/SQL)} {
	set apl {declare my_result number; begin :my_result := oratcl___async1(:in1); end;}
	looping_async_parse_namespace $async_stm $apl
	::oratcl::orabind $async_stm :my_result {} :in1 38
	looping_async_exec_namespace $async_stm
	set outvar [looping_async_fetch_namespace $async_stm]
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_fetch-4.5 {oraasync fetch command (PL/SQL)} {
	set apl {declare my_result number; begin :my_result := oratcl___async1(:in1); end;}
	looping_async_parse $async_stm $apl
	orabind $async_stm :my_result {} :in1 38
	looping_async_exec $async_stm
	set outvar [looping_async_fetch $async_stm]
	oramsg $async_stm rc
} $::oratcl::codes(OCI_SUCCESS)

test oratcl::async_fetch-5.0 {oraasync (PL/SQL) use + reuse} {
	set apl {declare my_result number; begin :my_result := oratcl___async1(:in1); end;}
	looping_async_parse $async_stm $apl
	orabind $async_stm :my_result {} :in1 38
	looping_async_exec $async_stm
	set outvar1 [looping_async_fetch $async_stm]
	orabind $async_stm :my_result {} :in1 28
	looping_async_exec $async_stm
	set outvar2 [looping_async_fetch $async_stm]
	set result [list $outvar1 $outvar2]
} [list [list 60 38] [list 50 28]]


orasql $block_stm "drop function oratcl___async1"

oraclose $async_stm
oralogoff $async_lda

::tcltest::cleanupTests
return
