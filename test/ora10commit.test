# ora10commit.test
#
# Copyright (c) 2000 by Todd M. Helfter
# All rights reserved.
# 
# exercise oracommit, oraroll, and oraautocom 
#

if {[info exists ora_lda] == 0} {source defs.tcl}

global ora_constr
set tst_lda [oralogon $ora_constr]
set tst_cur [oraopen $lda]

test oracommit-1.1 {orasql: commit} {
  orasql $ora_cur {update oratcl___tests set v_varchar2 = 'changed1' where v_number = 0}
  oracommit $ora_cur
  orasql $tst_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  set res [orafetch $tst_cur]
  set res 
} {changed1}

test oracommit-1.2 {orasql: commit} {
  orasql $ora_cur {update oratcl___tests set v_varchar2 = 'changed2' where v_number = 0}
  oraroll $ora_cur
  orasql $tst_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  set res [orafetch $tst_cur]
  set res 
} {changed1}

test oracommit-1.3 {orasql: commit} {
  oraautocom $ora_cur on
  orasql $ora_cur {update oratcl___tests set v_varchar2 = 'changed3' where v_number = 0}
  orasql $tst_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  orafetch $tst_cur {} {} res 1
  oraautocom $ora_cur off
  set res 
} {changed3}

oraclose $cur
oralogoff $lda

::tcltest::cleanupTests
return
