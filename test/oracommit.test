# oracommit.test
#
# Copyright (c) 2000 by Todd M. Helfter
# All rights reserved.
#
# exercise oracommit, oraroll, and oraautocom
#

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

global ora_constr
set tst1_lda [oralogon $ora_constr]
set tst2_lda [oralogon $ora_constr]
set tst1_cur [oraopen $tst1_lda]
set tst2_cur [oraopen $tst2_lda]

test oracommit-1.1 {orasql: commit} {
  orasql $tst1_cur {update oratcl___tests set v_varchar2 = 'changed1' where v_number = 0}
  oracommit $tst1_lda
  orasql $tst2_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  orafetch $tst2_cur -datavariable res
  set res 
} {changed1}

test oracommit-1.2 {orasql: commit} {
  orasql $tst2_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  set res [orafetch $tst2_cur]
  orasql $tst1_cur {update oratcl___tests set v_varchar2 = 'changed2' where v_number = 0}
  oraroll $tst1_lda
  orasql $tst2_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  set res [orafetch $tst2_cur]
  set res 
} {changed1}

test oracommit-1.3 {orasql: commit} {
  oraautocom $tst1_lda on
  orasql $tst1_cur {update oratcl___tests set v_varchar2 = 'changed3' where v_number = 0}
  orasql $tst2_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  orafetch $tst2_cur {} {} res 1
  oraautocom $tst1_lda off
  set res 
} {changed3}

test oracommit-1.4 {orasql: commit} {
  oraautocom $tst1_lda true
  orasql $tst1_cur {update oratcl___tests set v_varchar2 = 'changed4' where v_number = 0}
  orasql $tst2_cur {select v_varchar2 from oratcl___tests where v_number = 0}
  orafetch $tst2_cur {} {} res 1
  oraautocom $tst1_lda false
  set res 
} {changed4}

oraclose $tst1_cur
oralogoff $tst1_lda
oraclose $tst2_cur
oralogoff $tst2_lda
unset tst1_cur
unset tst1_lda
unset tst2_cur
unset tst2_lda

::tcltest::cleanupTests
return
