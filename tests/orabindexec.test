#
# exercise various calls to orabindexec
#

package require tcltest

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

::tcltest::configure -verbose ept

::tcltest::test orabindexec-1.1 {orabindexec: one bind value} {
	-setup {
		set tst11(lda) [oralogon $ora_constr]
		set tst11(stm) [oraopen $tst11(lda)]
		set tst11(sql) {select v_number \
				from oratcl___tests \
				where v_char = :n1}
		oraparse $tst11(stm) $tst11(sql)
	}
	-body {
		orabindexec $tst11(stm) :n1 {10}
		orafetch $tst11(stm) -datavariable tst11(res)
		set tst11(res)
	}
	-cleanup {
		oraclose $tst11(stm)
		oralogoff $tst11(lda)
		array unset tst11
	}
	-result {10}
}

::tcltest::test orabindexec-1.2 {orabindexec: bind values :: success code} {
	-setup {
		set tst12(lda) [oralogon $ora_constr]
		set tst12(stm) [oraopen $tst12(lda)]
		set tst12(sql) {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst12(stm) $tst12(sql)
	}
	-body {
		set tst12(res) [orabindexec $tst12(stm) :n1 {10} :n2 {10} :n3 {10%}]
		set tst12(res)
	}
	-cleanup {
		oraclose $tst12(stm)
		oralogoff $tst12(lda)
		array unset tst12
	}
	-result {0}
}

::tcltest::test orabindexec-1.3 {orabindexec: multiple bind values} {
	-setup {
		set tst13(lda) [oralogon $ora_constr]
		set tst13(stm) [oraopen $tst13(lda)]
		set tst13(sql) {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst13(stm) $tst13(sql)
	}
	-body {
		orabindexec $tst13(stm) :n1 {10} :n2 {10} :n3 {10%}
		orafetch $tst13(stm) -datavariable tst13(res)
		set tst13(res)
	}
	-cleanup {
		oraclose $tst13(stm)
		oralogoff $tst13(lda)
		array unset tst13
	}
	-result {10}
}

::tcltest::test orabindexec-1.4 {orabindexec: too few bind values :: result} {
	-setup {
		set tst14(lda) [oralogon $ora_constr]
		set tst14(stm) [oraopen $tst14(lda)]
		set tst14(sql) {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst14(stm) $tst14(sql)
	}
	-body { 
		  orabindexec $tst14(stm) :n1 {10} :n2 {10}
	}
	-cleanup {
		oraclose $tst14(stm)
		oralogoff $tst14(lda)
		array unset tst14
	}
	-result {ORA-01008: not all variables bound}
	-returnCodes {1}
} 


::tcltest::test orabindexec-1.5 {orabindexec: too few bind values :: error code} {
	-setup {
		set tst15(lda) [oralogon $ora_constr]
		set tst15(stm) [oraopen $tst15(lda)]
		set tst15(sql) {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst15(stm) $tst15(sql)
	}
	-body { 
		catch {orabindexec $tst15(stm) :n1 {10} :n2 {10}}
		oramsg $tst15(stm) rc
	}
	-cleanup {
		oraclose $tst15(stm)
		oralogoff $tst15(lda)
		array unset tst15
	}
	-result 1008
}

::tcltest::test orabindexec-1.6 {orabindexec: no prior parse :: error code} {
	-setup {
		set tst16(lda) [oralogon $ora_constr]
		set tst16(stm) [oraopen $tst16(lda)]
	}
	-body { 
		catch {set tst16(rs1) [orabindexec $tst16(stm) :n1 {10} :n2 {10}]}
		oramsg $tst16(stm) rc
	} 
	-cleanup {
		oraclose $tst16(stm)
		oralogoff $tst16(lda)
		array unset tst16
	}
	-result {1036}
}

::tcltest::cleanupTests
::tcltest::configure -verbose b
return
