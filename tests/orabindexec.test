# exercise various calls to orabindexec
#

package require tcltest

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

::tcltest::configure -verbose ept

::tcltest::test orabindexec-1.1 {orabindexec: one bind value} {
	-setup {
		set tst_lda [oralogon $ora_constr]
		set tst_cur [oraopen $tst_lda]
		set sql {select v_number \
				from oratcl___tests \
				where v_char = :n1}
		oraparse $tst_cur $sql
	}
	-body {
		orabindexec $tst_cur :n1 {10}
		orafetch $tst_cur -datavariable rv1
		#unset sql
		set res $rv1
		unset rv1
		set res
	}
	-cleanup {
		oraclose $tst_cur
		oralogoff $tst_lda
		unset tst_cur
		unset tst_lda
	}
	-result 10
}

::tcltest::test orabindexec-1.2 {orabindexec: bind values :: success code} {
	-setup {
		set tst_lda [oralogon $ora_constr]
		set tst_cur [oraopen $tst_lda]
		set sql {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst_cur $sql
	}
	-body {
		set rc [orabindexec $tst_cur :n1 {10} :n2 {10} :n3 {10%}]
		set rc
	}
	-cleanup {
		oraclose $tst_cur
		oralogoff $tst_lda
		unset tst_cur
		unset tst_lda
	}
	-result 0
}

::tcltest::test orabindexec-1.3 {orabindexec: multiple bind values} {
	-setup {
		set tst_lda [oralogon $ora_constr]
		set tst_cur [oraopen $tst_lda]
		set sql {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst_cur $sql
	}
	-body {
		orabindexec $tst_cur :n1 {10} :n2 {10} :n3 {10%}
		orafetch $tst_cur -datavariable rv1
		set res $rv1
		unset rv1
		set res
	}
	-cleanup {
		oraclose $tst_cur
		oralogoff $tst_lda
		unset tst_cur
		unset tst_lda
	}
	-result 10
}

::tcltest::test orabindexec-1.4 {orabindexec: too few bind values :: result} {
	-setup {
		set tst_lda [oralogon $ora_constr]
		set tst_cur [oraopen $tst_lda]
		set sql {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst_cur $sql
	}
	-body { 
		  catch {orabindexec $tst_cur :n1 {10} :n2 {10}} res
		  set res
	}
	-cleanup {
		oraclose $tst_cur
		oralogoff $tst_lda
		unset tst_cur
		unset tst_lda
	}
	-result {orabindexec: SQL execution failed.}
} 


::tcltest::test orabindexec-1.5 {orabindexec: too few bind values :: error code} {
	-setup {
		set tst_lda [oralogon $ora_constr]
		set tst_cur [oraopen $tst_lda]
		set sql {select v_number \
				from oratcl___tests \
				where v_char = :n1 \
				and v_number = :n2 \
				and v_varchar2 like :n3}
		oraparse $tst_cur $sql
	}
	-body { 
		catch {orabindexec $tst_cur :n1 {10} :n2 {10}} res
		oramsg $tst_cur rc
	}
	-cleanup {
		oraclose $tst_cur
		oralogoff $tst_lda
		unset tst_cur
		unset tst_lda
	}
	-result 1008
}

::tcltest::test orabindexec-1.6 {orabindexec: no prior parse :: error code} {
	-setup {
		set tst_lda [oralogon $ora_constr]
		set tst_cur [oraopen $tst_lda]
	}
	-body { 
		catch {set res [orabindexec $tst_cur :n1 {10} :n2 {10}]} cr
#puts "TMH :: res = $res"
#puts "TMH :: cr = $cr"
		set res [oramsg $tst_cur rc]
#puts "TMH :: res = $res"
		set res
	} 
	-cleanup {
		oraclose $tst_cur
		oralogoff $tst_lda
		unset tst_cur
		unset tst_lda
	}
	-result 1036
}

::tcltest::cleanupTests
::tcltest::configure -verbose b
return
