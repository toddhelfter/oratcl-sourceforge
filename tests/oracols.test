# oracols.test
#
# Copyright (c) 2000 by Todd M. Helfter
# All rights reserved.
#
# exercise various oracols
#

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

set oracol_sql {select v_number, v_date, v_char, v_varchar2 from oratcl___tests}
set all_result [list [list V_NUMBER 40 NUMBER {} {}]]

set name_result [list V_NUMBER V_DATE V_CHAR V_VARCHAR2]
set size_result [list 40 75 2 36]
set size_result [list 22 7 2 36]

set type_result [list NUMBER DATE CHAR VARCHAR2]
set prec_result [list 2 {} {} {}]
set scale_result [list 0 {} {} {}]
set null_result [list 1 1 1 1]
set all_result [list {V_NUMBER 22 NUMBER 2 0 1} {V_DATE 7 DATE {} {} 1} {V_CHAR 2 CHAR {} {} 1} {V_VARCHAR2 36 VARCHAR2 {} {} 1}]

test oracols-1.1 {oracols: all options after oraparse} {
  global oracol_sql name_result size_result type_result
  oraparse $ora_cur $oracol_sql
  set cols1 [oracols $ora_cur]
  set cols2 [oracols $ora_cur size]
  set cols3 [oracols $ora_cur type]
  set cols4 [oracols $ora_cur precision]
  set cols5 [oracols $ora_cur scale]
  set cols6 [oracols $ora_cur nullok]
  set cols7 [oracols $ora_cur all]
  set res [expr {([string compare $cols1 $name_result] == 0) +
		([string compare $cols2 $size_result] == 0) +
		([string compare $cols3 $type_result] == 0) +
		([string compare $cols4 $prec_result] == 0) +
		([string compare $cols5 $scale_result] == 0) +
		([string compare $cols6 $null_result] == 0) +
		([string compare $cols7 $all_result] == 0)}]
  unset cols1
  unset cols2
  unset cols3
  unset cols4
  unset cols5
  unset cols6
  unset cols7
  set res
} {7}

::tcltest::cleanupTests
return
