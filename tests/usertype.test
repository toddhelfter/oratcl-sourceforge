#
# exercise user defined types
#

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

global ora_constr
set type_lda [oralogon $ora_constr]
set type_stm [oraopen $type_lda]

set type_sql(create_type) { \
	create type oratcl_type as object ( \
		name	varchar2(30), \
		phone	varchar2(20) \
	) \
}

set type_sql(create_type_table) {
	create table oratcl_type_table ( \
		id number(5), \
		ot oratcl_type \
	)
}

if 0 {
set type_sql(insert_lob_table) { \
	insert into oratcl_lob (lob_key) values (:lob_key) \
}

set type_sql(select_lob_table) { \
	select rowid from oratcl_lob where lob_key = :lob_key \
}
}

set type_sql(drop_type_table) {
	drop table oratcl_type_table
}

set type_sql(drop_type) {
	drop type oratcl_type
}

oraparse $type_stm $type_sql(create_type)
oraexec $type_stm
oraparse $type_stm $type_sql(create_type_table)
oraexec $type_stm

if 0 {
oraparse $type_stm $type_sql(insert_lob_table)
orabind $type_stm :lob_key l1
oraexec $type_stm
orabind $type_stm :lob_key l2
oraexec $type_stm

oracommit $type_lda

oraparse $type_stm $type_sql(select_lob_table)
orabind $type_stm :lob_key l1
oraexec $type_stm
orafetch $type_stm -datavariable rowid1
orabind $type_stm :lob_key l2
oraexec $type_stm
orafetch $type_stm -datavariable rowid2

set chr_data [string repeat 0123456789---------- 10000]

set fileId [open [info nameofexecutable] r]
fconfigure $fileId -translation binary
set bin_data [read $fileId]
close $fileId

test oralob-1.0 {oralob: alloc and free clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	catch {oralob free $lob} free
	list $lob $free
} {oralob.0 0}

test oralob-1.1 {oralob: alloc and free blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	catch {oralob free $lob} free
	list $lob $free
} {oralob.1 0}

test oralob-1.2 {oralob: write clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	catch {oralob write $lob -datavar chr_data} write
	catch {oralob free $lob} free
	list $lob $write $free
} {oralob.2 0 0}

test oralob-1.3 {oralob: read clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	catch {oralob read $lob -datavar chr_out} res
	set read [string equal $chr_data $chr_out]
	unset chr_out
	catch {oralob free $lob} free
	list $lob $read $free
} {oralob.3 1 0}

test oralob-1.4 {oralob: write blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	catch {oralob write $lob -datavar bin_data} write
	catch {oralob free $lob} free
	list $lob $write $free
} {oralob.4 0 0}

test oralob-1.5 {oralob: read blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	catch {oralob read $lob -datavar bin_out} write
	catch {oralob free $lob} free
	set read [string equal $bin_data $bin_out]
	list $lob $read $free
} {oralob.5 1 0}

test oralob-1.6 {oralob: length clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	catch {oralob length $lob} length
	catch {oralob free $lob} free
	set res [expr {[string length $chr_data] == $length}]
	list $lob $res $free
} {oralob.6 1 0}

test oralob-1.7 {oralob: length blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	catch {oralob length $lob} length
	catch {oralob free $lob} free
	set res [expr {[string length $bin_data] == $length}]
	list $lob $res $free
} {oralob.7 1 0}

test oralob-1.8 {oralob: trim clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	set half [expr {[string length $chr_data] / 2}]
	catch {oralob trim $lob -length $half} trim
	catch {oralob length $lob} length
	catch {oralob free $lob} free
	set res [expr {$half == $length}]
	list $lob $res $free
} {oralob.8 1 0}

test oralob-1.9 {oralob: trim blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	set half [expr {[string length $bin_data] / 2}]
	catch {oralob trim $lob -length $half} trim
	catch {oralob length $lob} length
	catch {oralob free $lob} free
	set res [expr {$half == $length}]
	list $lob $res $free
} {oralob.9 1 0}

test oralob-1.10 {oralob: substr clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	set sub [string range $chr_data 10 100] 
	catch {oralob substr $lob -start 10 -stop 100 -datavar sub_out}
	catch {oralob free $lob} free
	set res [expr {$sub == $sub_out}]
	list $lob $res $free
} {oralob.10 1 0}

test oralob-1.11 {oralob: substr blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	set sub [string range $bin_data 10 100] 
	catch {oralob substr $lob -start 10 -stop 100 -datavar sub_out} 
	catch {oralob free $lob} free
	set res [expr {$sub == $sub_out}]
	list $lob $res $free
} {oralob.11 1 0}

test oralob-1.12 {oralob: erase clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	set source "[string range $chr_data 10 11]   [string range $chr_data 15 16]" 
	catch {oralob erase $lob -start 12 -stop 14} erase_res
	catch {oralob substr $lob -start 10 -stop 16 -datavar erase_out}
	catch {oralob free $lob} free
	set res [string equal $source $erase_out]
	unset erase_res
	unset erase_out
	list $lob $res $free
} {oralob.12 1 0}

test oralob-1.13 {oralob: erase blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	set source "[string range $bin_data 10 11]   [string range $bin_data 15 16]" 
	set p1 [string range $bin_data 20 21]
	binary scan $p1 H* p1h
	set p2 [string range $bin_data 25 26]
	binary scan $p2 H* p2h
	set source [binary format H* ${p1h}000000${p2h}]
	catch {oralob erase $lob -start 22 -stop 24} erase_res
	catch {oralob substr $lob -start 20 -stop 26 -datavar erase_out}
	catch {oralob free $lob} free
	set res [string equal $source $erase_out]
	list $lob $res $free
} {oralob.13 1 0}

test oralob-1.14 {oralob: instr clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	set pattern [string range $chr_data 15 50]
	set pos [oralob instr $lob -pattern $pattern]
	catch {oralob free $lob} free
	list $lob $pos $free
} {oralob.14 15 0}

test oralob-1.15 {oralob: instr blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob
	set pattern [string range $bin_data 15 20]
	set pos [oralob instr $lob -pattern $pattern]
	catch {oralob free $lob} free
	list $lob $pos $free
} {oralob.15 15 0}

test oralob-2.0 {oralob: append clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob1
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid2} lob2
	catch {oralob append $lob2 $lob1} res
	catch {oralob free $lob1} free1
	catch {oralob free $lob2} free2
	set res
} {0}

test oralob-2.1 {oralob: append blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob1
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid2} lob2
	catch {oralob append $lob2 $lob1} res
	catch {oralob free $lob1} free1
	catch {oralob free $lob2} free2
	set res
} {0}

test oralob-3.0 {oralob: compare clob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob1
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid2} lob2
	catch {oralob compare $lob1 $lob2} res
	catch {oralob free $lob1} free1
	catch {oralob free $lob2} free2
	set res
} {0}

test oralob-3.1 {oralob: compare blob} {
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid1} lob1
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_blob -rowid $rowid2} lob2
	catch {oralob compare $lob1 $lob2} res
	catch {oralob free $lob1} free1
	catch {oralob free $lob2} free2
	set res
} {0}

test oralob-4.0 {oralob: write clob 'double character'} {
	set one_chr zz
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	catch {oralob write $lob -datavar one_chr} write
	catch {oralob read $lob -datavar one_out} res
	set res [string equal $one_chr $one_out]
	catch {oralob free $lob} free
	set res
} {1}

test oralob-4.1 {oralob: write clob 'single character'} {
	set one_chr z
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	catch {oralob write $lob -datavar one_chr} write
	catch {oralob read $lob -datavar one_out} res
	set res [string equal $one_chr $one_out]
	catch {oralob free $lob} free
	set res
} {1}

test oralob-4.2 {oralob: write clob 'null string'} {
	set one_chr {}
	catch {oralob alloc $type_stm -table oratcl_lob -column lob_clob -rowid $rowid1} lob
	catch {oralob write $lob -datavar one_chr} write
	catch {oralob read $lob -datavar one_out} res
	set res [string equal $one_chr $one_out]
	catch {oralob free $lob} free
	set res
} {1}
}


oraparse $type_stm $type_sql(drop_type_table)
oraexec $type_stm
oraparse $type_stm $type_sql(drop_type)
oraexec $type_stm

oraclose $type_stm
oralogoff $type_lda
unset type_stm
unset type_lda

::tcltest::cleanupTests
return
