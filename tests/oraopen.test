#
# exercise oraopen and oraclose
#

package require tcltest 2.2

::tcltest::configure -verbose ept

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

namespace eval ::oratest::oraopen {
        namespace import ::tcltest::*

        configure -verbose ept
        testConstraint testopen [llength [info commands oraopen]]

	::tcltest::test oraopen-1.0 {oraopen: all arguments} {
		-body {
			#global ora_lda
			catch {set cur [oraopen $ora_lda]} res
			set res
		}
		-cleanup {
			catch {oraclose $cur}
			unset cur
		}
		-result {oratcl0.3}
	}

	::tcltest::test oraopen-1.1 {oraopen: no arguments} {
		-body {
			catch {oraopen} res
			set res
		}
		-result {wrong # args: should be "oraopen lda_handle"}
	} 

	::tcltest::test oraopen-1.2 {oraopen: many cursors} {
		-setup {
			set tst(lda) [oralogon $ora_constr]
			set cur_list {}
		}
		-body {
			for {set n 0} {$n < 100} {incr n} {
				set cr [catch {set tst(st$n) [oraopen $tst(lda)]}]
				if {$cr == 0} {
					lappend cur_list $tst(st$n)
				} else {
					break
				}
			}
			set res [llength $cur_list]
		}
		-cleanup {
			foreach cur $cur_list {
				catch {oraclose $cur}
			}
			oralogoff $tst(lda)
			array unset tst
			unset cur_list
			unset cur
		}
		-result 100
	} 

	configure -verbose b
        cleanupTests
}

namespace delete ::oratest::oraopen
