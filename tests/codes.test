# exercise various oraasync operations
#
package require tcltest

::tcltest::configure -verbose ept

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}


::tcltest::test oratcl::codes-1.1 {::oratcl::codes array} {
	-body {
		if {[info exists ::oratcl::codes(OCI_INVALID_HANDLE)]} {
			set ::oratcl::codes(OCI_INVALID_HANDLE)
		}
	}
	-cleanup {
	}
	-result {-2}
}

::tcltest::test oratcl::codes-1.2 {::oratcl::codes array} {
	-body {
		if {[info exists ::oratcl::codes(OCI_ERROR)]} {
			set ::oratcl::codes(OCI_ERROR)
		}
	}
	-cleanup {
	}
	-result {-1}
}

::tcltest::test oratcl::codes-1.3 {::oratcl::codes array} {
	-body {
		if {[info exists ::oratcl::codes(OCI_SUCCESS)]} {
			set ::oratcl::codes(OCI_SUCCESS)
		}
	}
	-cleanup {
	}
	-result {0}
}

::tcltest::test oratcl::codes-1.4 {::oratcl::codes array} {
	-body {
		if {[info exists ::oratcl::codes(OCI_SUCCESS_WITH_INFO)]} {
			set ::oratcl::codes(OCI_SUCCESS_WITH_INFO)
		}
	}
	-cleanup {
	}
	-result {1}
}

::tcltest::test oratcl::codes-1.5 {::oratcl::codes array} {
	-body {
		if {[info exists ::oratcl::codes(OCI_NEED_DATA)]} {
			set ::oratcl::codes(OCI_NEED_DATA)
		}
	}
	-cleanup {
	}
	-result {99}
}

::tcltest::test oratcl::codes-1.6 {::oratcl::codes array} {
	-body {
		if {[info exists ::oratcl::codes(OCI_NO_DATA)]} {
			set ::oratcl::codes(OCI_NO_DATA)
		}
	}
	-cleanup {
	}
	-result {100}
}


::tcltest::test oratcl::codes-1.7 {::oratcl::codes array} {
	-body {
		if {[info exists ::oratcl::codes(OCI_STILL_EXECUTING)]} {
			set ::oratcl::codes(OCI_STILL_EXECUTING)
		}
	}
	-cleanup {
	}
	-result {-3123}
}

::tcltest::cleanupTests
::tcltest::configure -verbose b

return
