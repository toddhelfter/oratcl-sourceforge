#
# exercise oralogon and oralogoff
#

package require tcltest

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

::tcltest::configure -verbose ept

::tcltest::test oralogon-1.0 {oralogon: no arguments} {
	-body {
		catch {oralogon} res
		set res
	}
	-result {wrong # args: should be "oralogon connect_string ?-async?"}
}

::tcltest::test oralogon-1.1 {oralogon: all arguments} {
	-body {
		catch {oralogon $ora_constr} res
		set res
	}
	-cleanup {
		catch {oralogoff $lda}
	}
	-result oratcl1
}

::tcltest::test oralogon-1.2 {oraopen: many connections} {
	-setup {
		set lda_list {}
	}
	-body {
		for {set n 0} {$n < 35} {incr n} {
			set cr [catch {set lda [oralogon $ora_constr]}]
			if {$cr == 0} {
				lappend lda_list $lda
			} else {
				break
			}
		}
		set res [llength $lda_list]
	}
	-cleanup {
		foreach lda $lda_list {
			catch {oralogoff $lda}
		}
		unset lda
		unset lda_list
		unset cr
		unset res
	}
	-result 35
}

::tcltest::cleanupTests
::tcltest::configure -verbose b
return
