			oraplexec $test23(stm) $test23(pls) :my_result {} :in1 22 :in2 22
		}
		oramsg $test23(stm) rc
	}
	-cleanup {
		oraclose $test23(stm)
		oralogoff $test23(lda)
		array unset test23
	}
	-result {6550}
