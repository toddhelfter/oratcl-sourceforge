# All rights reserved.
#
# exercise various oraplexec operations
#

package require tcltest
::tcltest::configure -verbose ept
::tcltest::testConstraint testoraplexec [llength [info commands oraplexec]]

if {[info exists ora_lda] == 0} {
	source [file  join [pwd] [file dirname [info script]] defs.tcl]
}

global ora_constr
set pl_lda [oralogon $ora_constr]
set pl_stm [oraopen $pl_lda]
set pl_exe [oraopen $pl_lda]
set pl_get [oraopen $pl_lda]

set sql {alter session set nls_date_format = 'DD-MON-YYYY'}
oraparse $pl_stm $sql
oraexec $pl_stm

set oratcl___test1 {
	create or replace function oratcl___test1 (
		arg_x number,
		arg_y char
	) return date as
	nres number(10);
	dres date;
	cursor cur_tests(arg_x number, arg_y char)
		is select v_number, v_date from oratcl___tests
			where v_number = arg_x
			and v_char = arg_y;
	begin

		open cur_tests(arg_x, arg_y);
		fetch cur_tests into nres, dres;
		close cur_tests;
		return dres;
	end;
}

set oratcl___test2 {
	create or replace function oratcl___test2 (
		arg_x number
	) return boolean as
	begin
		if (arg_x = 5) then
			return TRUE;
		else
			return FALSE;
		end if;
	end;
}

set oratcl_pkg {
	CREATE OR REPLACE PACKAGE oratcl___test_pkg AS
		TYPE CurType IS REF CURSOR RETURN oratcl___tests%ROWTYPE;
		PROCEDURE open_ref_cur (ref_cur IN OUT CurType);
	END;
}

set oratcl_pkgbody {
	CREATE OR REPLACE PACKAGE BODY oratcl___test_pkg AS
		PROCEDURE open_ref_cur (ref_cur IN OUT CurType) IS
		BEGIN
			OPEN ref_cur FOR SELECT * FROM oratcl___tests
				WHERE v_number is not null;
		END open_ref_cur;
	END;
}

oraplexec $pl_stm $oratcl___test1
oraplexec $pl_stm $oratcl___test2
oraplexec $pl_stm $oratcl_pkg
oraplexec $pl_stm $oratcl_pkgbody

::tcltest::test oraplexec-1.1 {oraplexec: :bind = function(val, val)} {
        -constraints testoraplexec
        -setup {
                set test1(lda) [oralogon $ora_constr]
                set test1(stm) [oraopen $test1(lda)]
		set test1(pl1) {declare my_result date; begin :my_result := oratcl___test1(22, '22'); end;}
		oraparse $test1(stm) {alter session set nls_date_format = 'DD-MON-YYYY'}
		oraexec $test1(stm)
        }
	-body {
		oraplexec $test1(stm) $test1(pl1) :my_result {}
		orafetch $test1(stm) -datavariable test1(rv1)
		set test1(rv2) [string toupper [clock format [clock seconds] -format {%d-%b-%Y}]]
		list [string equal $test1(rv1) $test1(rv2)]
	}
	-cleanup {
                oraclose $test1(stm)
                oralogoff $test1(lda)
                array unset test1
	}
	-result {1}
}

::tcltest::test oraplexec-1.2 {oraplexec: :bind = function(:bindval, val)} {
        -constraints testoraplexec
        -setup {
                set test2(lda) [oralogon $ora_constr]
                set test2(stm) [oraopen $test2(lda)]
		set test2(pl2) {declare my_result date; begin :my_result := oratcl___test1(:in1, '22'); end;}
		oraparse $test2(stm) {alter session set nls_date_format = 'DD-MON-YYYY'}
		oraexec $test2(stm)
        }
	-body {
		oraplexec $test2(stm) $test2(pl2) :my_result {} :in1 22
		orafetch $test2(stm) -datavariable test2(rv1)
		set test2(rv2) [list [string toupper [clock format [clock seconds] -format {%d-%b-%Y}]] 22]
		list [string equal $test2(rv1) $test2(rv2)]
	}
	-cleanup {
                oraclose $test2(stm)
                oralogoff $test2(lda)
                array unset test2
	}
	-result {1}
}

::tcltest::test oraplexec-1.3 {oraplexec: :bind = function(:bindval, :bindval)} {
        -constraints testoraplexec
        -setup {
                set test3(lda) [oralogon $ora_constr]
                set test3(stm) [oraopen $test3(lda)]
		set test3(pl3) {declare my_result date; begin :my_result := oratcl___test1(:in1, :in2); end;}
		oraparse $test3(stm) {alter session set nls_date_format = 'DD-MON-YYYY'}
		oraexec $test3(stm)
        }
	-body {
		oraplexec $test3(stm) $test3(pl3) :my_result {} :in1 22 :in2 {22}
		orafetch $test3(stm) -datavariable test3(rv1)
		set test3(rv2) [list [string toupper [clock format [clock seconds] -format {%d-%b-%Y}]] 22 22]
		list [string equal $test3(rv1) $test3(rv2)]
	}
	-cleanup {
                oraclose $test3(stm)
                oralogoff $test3(lda)
                array unset test3
	}
	-result {1}
}

test oraplexec-1.4 {oraplexec: bad bind pairs :: result} {
  set pl(4) {declare my_result date; begin :my_result := oratcl___test1(:in1, :in2); end;}
  catch {oraplexec $pl_stm $pl(4) :my_result {} :in1 22 :in2} res
  oramsg $pl_stm error
} [list [format "ORA-01008: not all variables bound"]]

test oraplexec-1.5 {oraplexec: bad bind pairs :: error code} {
  set pl(5) {declare my_result date; begin :my_result := oratcl___test1(:in1, :in2); end;}
  catch {oraplexec $pl_stm $pl(5) :my_result {} :in1 22 :in2} res
  oramsg $pl_stm rc
} {1008}

test oraplexec-1.6 {oraplexec: bad pl/sql :: error text} {
  set pl(9) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $pl_stm $pl(5) :my_result {} :in1 22 :in2} res
  oramsg $pl_stm error
} [list [format "ORA-01008: not all variables bound"]]

test oraplexec-1.7 {oraplexec: bad pl/sql :: result} {
  set pl(7) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $pl_stm $pl(7) :my_result {} :in1 22 :in2 22} res
  oramsg $pl_stm error
} [list [format "ORA-06550: line 1, column 45:\nPLS-00201: identifier 'ORATCL___TEST' must be declared\nORA-06550: line 1, column 31:\nPL/SQL: Statement ignored"]]

test oraplexec-1.8 {oraplexec: bad pl/sql :: error code} {
  set pl(8) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $pl_stm $pl(8) :my_result {} :in1 22 :in2 22}
  oramsg $pl_stm rc
} {6550}

test oraplexec-1.9 {oraplexec: bad pl/sql :: error text} {
  set pl(9) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
  catch {oraplexec $pl_stm $pl(9) :my_result {} :in1 22 :in2 22}
  oramsg $pl_stm error
} [list [format "ORA-06550: line 1, column 45:\nPLS-00201: identifier 'ORATCL___TEST' must be declared\nORA-06550: line 1, column 31:\nPL/SQL: Statement ignored"]]

test oraplexec-1.10 {oraplexec: :bind = function(val)} {
  set pls {declare my_result boolean; begin :my_result := oratcl___test2(5); end;}
  catch {oraplexec $pl_stm $pls :my_result {} } res
  oramsg $pl_stm error
} [list [format "ORA-06550: line 1, column 48:\nPLS-00382: expression is of wrong type\nORA-06550: line 1, column 34:\nPL/SQL: Statement ignored"]]

test oraplexec-1.11 {oraplexec: procedure(:bind_ref_cursor)} {
	set plsql {begin oratcl___test_pkg.open_ref_cur(:ret_cur); end;}
	oraplexec $pl_exe $plsql :ret_cur $pl_get
	set cnt 0
	orafetch $pl_get -command {incr cnt}
	while {[oramsg $pl_get rc] == 0} {
		orafetch $pl_get -command {incr cnt}
	}
	set cnt
} 30

oraparse $pl_stm "drop function oratcl___test1"
oraexec $pl_stm
oraparse $pl_stm "drop function oratcl___test2"
oraexec $pl_stm
oraparse $pl_stm "drop package oratcl___test_pkg"
oraexec $pl_stm

oraclose $pl_get
oraclose $pl_exe
oraclose $pl_stm
oralogoff $pl_lda

#array unset pl
#unset $pl_stm
#unset $pl_lda

::tcltest::cleanupTests
::tcltest::configure -verbose b

return
