        -constraints testoraplexec
        -setup {
		set test21(lda) [oralogon $ora_constr]
		set test21(stm) [oraopen $test21(lda)]
		set test21(pls) {declare my_result date; begin :my_result := oratcl___test1(:in1, :in2); end;}
        }
	-body {
		catch {
			oraplexec $test21(stm) $test21(pls) :my_result {} :in1 22 :in2
		}
		oramsg $test21(stm) rc
	}
	-cleanup {
		oraclose $test21(stm)
		oralogoff $test21(lda)
		array unset test21
	}
	-result {1008}
	-returnCodes {0}
}

::tcltest::test oraplexec-2.2 {oramsg : error} {
        -constraints testoraplexec
        -setup {
		set test22(lda) [oralogon $ora_constr]
		set test22(stm) [oraopen $test22(lda)]
		set test22(pls) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
        }
	-body {
		catch {
			oraplexec $test22(stm) $test22(pls) :my_result {} :in1 22 :in2 22
		}
		string equal \
			[oramsg $test22(stm) error] \
			[format "ORA-06550: line 1, column 45:\nPLS-00201: identifier 'ORATCL___TEST' must be declared"]
	}
	-cleanup {
		oraclose $test22(stm)
		oralogoff $test22(lda)
		array unset test22
	}
	-result {0}
	-returnCodes {0}
}

