::tcltest::test oraplexec-2.4 {oramsg : error} {
        -constraints testoraplexec
        -setup {
		set test24(lda) [oralogon $ora_constr]
		set test24(stm) [oraopen $test24(lda)]
		set test24(pls) {declare my_result boolean; begin :my_result := oratcl___test2(5); end;}
        }
	-body {
		catch {
			oraplexec $test24(stm) $test24(pls) :my_result {}
		}
		string equal \
			[oramsg $test24(stm) error] \
			[format "%s\n%s\n%s\n%s" \
			        {ORA-06550: line 1, column 48:} \
				{PLS-00382: expression is of wrong type} \
				{ORA-06550: line 1, column 34:} \
				{PL/SQL: Statement ignored}]
	}
	-cleanup {
		oraclose $test24(stm)
		oralogoff $test24(lda)
		array unset test24
	}
	-result {0}
	-returnCodes {0}
}

::tcltest::test oraplexec-3.0 {oraplexec bind :ref_cursor} {
        -constraints testoraplexec
        -setup {
		set test30(lda) [oralogon $ora_constr]
		set test30(st1) [oraopen $test30(lda)]
		set test30(st2) [oraopen $test30(lda)]
		set test30(pls) {begin oratcl___test_pkg.open_ref_cur(:ret_cur); end;}
        }
	-body {
		oraplexec $test30(st1) $test30(pls) :ret_cur $test30(st2)
		set test30(cnt) 0
		while {[orafetch $test30(st2)] == 0} {
			incr test30(cnt)
		}
		set test30(cnt)
	}
	-cleanup {
		oraclose $test30(st1)
		oraclose $test30(st2)
		oralogoff $test30(lda)
		array unset test30
	}
	-result {30}
	-returnCodes {0}
}

oraplexec_final

::tcltest::cleanupTests
::tcltest::configure -verbose b

return
