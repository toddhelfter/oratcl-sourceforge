        -constraints testoraplexec
        -setup {
		set test23(lda) [oralogon $ora_constr]
		set test23(stm) [oraopen $test23(lda)]
		set test23(pls) {declare my_result date; begin :my_result := oratcl___test(:in1, :in2); end;}
